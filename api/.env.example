# === ESTIM CAMPUS — EXEMPLE DE CONFIGURATION (copier vers .env) ===

# Django
DJANGO_SECRET_KEY=change-moi-avec-une-vraie-cle-secrete
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=estim-campus.alwaysdata.net
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True

# Base de données (sqlite local OU postgres AlwaysData)
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://user:pass@postgresql-estim.alwaysdata.net:5432/estim_db

# CORS / CSRF (front + webhooks GitHub)
CSRF_TRUSTED_ORIGINS=https://estim-campus.alwaysdata.net

# Paiement OpenPay
OPENPAY_API_KEY=

# WhatsApp / SMS tuteur
WHATSAPP_ENABLED=True
WHATSAPP_MIN_DELAY_SECONDS=12
WHATSAPP_DAILY_LIMIT=500

# Webhook GitHub -> https://estim-campus.alwaysdata.net/api/deploy/webhook/
# Mets la même valeur dans GitHub > Settings > Webhooks > Secret :
DEPLOY_WEBHOOK_SECRET=change-moi-token-long-aleatoire

# Superuser créé auto par `manage.py ensure_root` (défauts : root / root)
DJANGO_SUPERUSER_USERNAME=root
DJANGO_SUPERUSER_PASSWORD=root
DJANGO_SUPERUSER_EMAIL=root@estim-campus.local
